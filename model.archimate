    <element xsi:type="archimate:BusinessFunction" name="[PR2] Negotiate and sign a new SLA" id="445fc8c4-80ea-464a-8aad-ed97997f1262"/>
    <element xsi:type="archimate:BusinessProcess" name="[PR4] Monitor service availability and continuity" id="eb008eb4-1882-4cf0-ae1f-b056858b6206"/>
    <element xsi:type="archimate:BusinessProcess" name="[PR6] Manage information security risks" id="2b8b6ed4-51cd-4672-b6fa-ddb28aa28e92"/>
    <element xsi:type="archimate:BusinessProcess" name="[PR6] Plan and implement information security controls" id="1e41cf17-cce8-4af7-b0db-ea15640db784"/>
    <element xsi:type="archimate:BusinessFunction" name="[PR2] Negotiate and sign an OLA / UA" id="581a570e-e3e1-4ae7-b688-cec447816fcb"/>
    <element xsi:type="archimate:BusinessFunction" name="[PR10] Escalate a problem" id="f3a10682-b895-4a90-98fc-b38126105f8e"/>
    <element xsi:type="archimate:BusinessProcess" name="[PR3] Maintain service report specifications" id="3e148934-36f8-4f58-9eb7-297626e3d68d"/>
    <element xsi:type="archimate:BusinessFunction" name="[PR10] Classify a problem" id="199969ff-0065-45b0-83c6-0904d3239349"/>
    <element xsi:type="archimate:BusinessProcess" name="[PR6] Perform access control" id="60a5d921-b138-4c0c-8552-aec451f10b14"/>
    <element xsi:type="archimate:BusinessProcess" name="[PR11] Verify configuration records" id="6ad9dcdf-7d1b-4a59-885a-0e394757062e"/>
    <element xsi:type="archimate:BusinessFunction" name="[PR11] Inform stakeholders about inconsistencies and identify follow-up actions" id="42f9ba71-e852-4c21-bf83-eac044dcc1cc"/>
  </folder>
  <folder name="Application" id="id-170fc92705d640edb95a56b874ec3596" type="application"/>
  <folder name="Technology &amp; Physical" id="id-b88bae40d46b4ebdb2cbf98fa24a7b21" type="technology"/>
  <folder name="Motivation" id="id-4c77b7a77f7747aaac972a328a442cdf" type="motivation">
    <element xsi:type="archimate:Requirement" name="PR6.4 Information security events and incidents shall be handled in a consistent manner." id="8c5b753a-2469-47de-a515-55b749987ca9"/>
    <element xsi:type="archimate:Requirement" name="PR7.6 Customer satisfaction shall be managed." id="0e58beb7-6554-41e7-88cb-e424023f15df"/>
    <element xsi:type="archimate:Requirement" name="PR7.3 Channels used to communicate with each customer including mechanisms for service ordering escalation and complaint shall be established." id="5377d522-1730-42f3-86ce-cb4017a94b13"/>
    <element xsi:type="archimate:Requirement" name="PR12.4 Changes shall be approved in a consistent manner. The required level of approval shall be determined based on defined criteria." id="8c35a977-8e5c-443e-85d8-272c3c3360a2"/>
    <element xsi:type="archimate:Requirement" name="PR5.2 Current capacity and utilisation shall be identified." id="c0993c4d-4f7a-439e-98f0-e9650ed109e8"/>
    <element xsi:type="archimate:Requirement" name="PR11.4 CIs shall be controlled and changes to CIs tracked in the CMDB." id="d11f646f-d78c-416b-9da9-09f882495b6f"/>
    <element xsi:type="archimate:Requirement" name="PR5.4 Performance of services and service components shall be analysed based on monitoring the degree of capacity utilisation and identifying operational warnings and exceptions." id="a5850dc5-c23a-4f86-93b2-387a4624e475"/>
    <element xsi:type="archimate:Requirement" name="PR7.1 Service customers shall be identified." id="88fedc52-1b57-4ecb-8930-741cfae4fc8d"/>
    <element xsi:type="archimate:Requirement" name="PR5.1 Service capacity and performance requirements shall be identified and reviewed at planned intervals taking into consideration SLAs and predicted demand." id="90ae8399-a17b-46bd-90d3-aeb4ee807a2e"/>
    <element xsi:type="archimate:Requirement" name="PR10.3 If a problem is not permanently resolved a known error shall be registered together with actions such as effective workarounds and temporary fixes." id="c7862913-7d36-47c3-8a2e-989e50964d1a"/>
    <element xsi:type="archimate:Requirement" name="PR6.3 Physical technical and organisational information security controls shall be implemented to reduce the probability and impact of identified information security risks and meet identified requirements." id="eccea863-dd74-4622-90d2-3452a8c1b6a4"/>
    <element xsi:type="archimate:Requirement" name="PR2.2 For all services delivered to customers service level agreements (SLAs) shall be in place and reviewed at planned intervals." id="c041e109-443d-4667-a1a9-8793324da283"/>
    <element xsi:type="archimate:Requirement" name="PR10.2 Problems shall be investigated to identify actions to resolve them or reduce their impact on services." id="59cb64b5-957e-4dd7-979f-c9f039f2343d"/>
    <element xsi:type="archimate:Requirement" name="PR10.4 Up-to-date information on known errors and effective workarounds shall be maintained." id="8a68bb01-8cd0-4cc0-99de-e3fd3ef778f3"/>
    <element xsi:type="archimate:Requirement" name="PR3.1 Required reports shall be identified. Reporting shall cover performance of services and processes against defined targets significant events and detected nonconformities." id="8a5721eb-9b0e-4bcd-93ef-ba7660c579cd"/>
    <element xsi:type="archimate:Requirement" name="PR11.3 Information on CIs and their relationships with other CIs shall be maintained in a configuration management database (CMDB)." id="d3a6b7ca-ebc4-4f33-bd38-02e7763f7e71"/>
    <element xsi:type="archimate:Requirement" name="PR13.6 Deployment activities shall be evaluated for success or failure." id="11f14fbe-9094-4f22-9ccb-f35f645164d7"/>
    <element xsi:type="archimate:Requirement" name="PR6.2 Information security risks shall be assessed at planned intervals." id="72d8e166-790c-443f-8161-c6370ed9db8d"/>
    <element xsi:type="archimate:Requirement" name="PR2.5 Performance of supporting services and service components shall be evaluated against targets defined in UAs and OLAs." id="dcb94fb9-f784-4ac6-b450-e796f3a1ad96"/>
    <element xsi:type="archimate:Requirement" name="PR11.5 The information stored in the CMDB shall be verified at planned intervals." id="a7ede657-867a-43ab-8508-de71cf339b18"/>
    <element xsi:type="archimate:Requirement" name="PR9.2 Incidents shall be resolved and service requests fulfilled taking into consideration information from SLAs and on known errors as relevant." id="8b110279-f3ac-44a2-bd98-fdddd2eb13bd"/>
    <element xsi:type="archimate:Requirement" name="PR13.2 Criteria for including approved changes in a release shall be defined taking into consideration the applicable release and deployment strategy." id="e833761b-cf4a-4f85-9aea-51a213ff32f9"/>
    <element xsi:type="archimate:Requirement" name="PR13.5 Deployment preparation shall consider steps to be taken in case of unsuccessful deployment." id="d2300880-49e1-4847-b393-b9324e5d4788"/>
    <element xsi:type="archimate:Requirement" name="PR5.3 Future capacity shall be planned to meet identified requirements considering human technical and financial resources." id="5f922558-2078-4d56-95fb-db2bff31e21c"/>
    <element xsi:type="archimate:Requirement" name="PR7.5 Service complaints from customers shall be handled in a consistent manner." id="274c7fc3-c04b-4f77-9861-1572d564d554"/>
    <element xsi:type="archimate:Requirement" name="PR9.5 Closure of incidents and service requests shall be carried out in a consistent manner." id="17d1b8e1-dfdf-4ab6-8518-22126d071270"/>
    <element xsi:type="archimate:Requirement" name="PR4.3 Appropriate measures shall be taken to reduce the probability and impact of identified availability and continuity risks and meet identified requirements." id="6631dbfa-db83-4528-81a1-26dd76b212d8"/>
    <element xsi:type="archimate:Requirement" name="PR9.1 All incidents and service requests shall be registered classified and prioritised in a consistent manner taking into account service targets from SLAs." id="f02048e8-34ce-4a2a-89cb-f9fc2027e627"/>
    <element xsi:type="archimate:Requirement" name="PR14.3 The implementation of actions for improvement shall be controlled in a consistent manner." id="b0ea7fdf-f11f-4558-b908-32517ce575d0"/>
    <element xsi:type="archimate:Requirement" name="PR1.4 For each service the internal and external suppliers involved in delivering the service shall be identified including" id="411d2a5d-3927-49f9-9f31-5edd1db4abc8"/>
    <element xsi:type="archimate:Requirement" name="PR14.2 Opportunities for improvement shall be evaluated in a consistent manner and actions to address them identified." id="bed69881-6bc7-43d2-95ab-a4a91801c08a"/>
    <element xsi:type="archimate:Requirement" name="PR11.2 The level of detail of configuration information shall be sufficient to support effective control over CIs." id="f23a7cc8-cb25-41cf-bb4c-9945f62d84f6"/>
    <element xsi:type="archimate:Requirement" name="PR3.2 Reports shall be agreed with their recipients and specified. The specification of each report shall include its identity purpose audience" id="bbc71eac-c6d1-4813-b088-a91516c0ec59"/>
    <element xsi:type="archimate:Requirement" name="PR2.3 Service performance shall be evaluated against service targets defined in SLAs." id="bc1a6831-0964-47e2-ba15-e103a23e4e39"/>
    <element xsi:type="archimate:Requirement" name="PR2.4 For supporting services or service components underpinning agreements (UAs) and operational level agreements (OLAs) shall be agreed as needed and reviewed at planned intervals." id="db9f4e23-1c2f-410a-b5c4-510299d78042"/>
    <element xsi:type="archimate:Requirement" name="PR12.3 Changes shall be assessed in a consistent manner taking into consideration benefits risks" id="834e528a-dda4-40cf-a618-35e184f711be"/>
    <element xsi:type="archimate:Requirement" name="PR8.4 Suppliers shall be evaluated at planned intervals." id="5cef46d3-72b9-4446-8820-42a6c398959b"/>
    <element xsi:type="archimate:Requirement" name="PR9.3 Functional and hierarchical escalation of incidents and service requests shall be carried out in a consistent manner." id="8fedec60-7ef6-4862-ab79-5fab802b5734"/>
    <element xsi:type="archimate:Requirement" name="PR6.1 Information security requirements shall be identified and information security policies defined and reviewed at planned intervals." id="4923a275-c070-44b3-916c-629c16dbaf08"/>
    <element xsi:type="archimate:Requirement" name="PR8.2 For each supplier there shall be a designated contact responsible for managing the relationship with them." id="58fa02a3-2612-4bfe-b16b-6b8d9b4e40a6"/>
    <element xsi:type="archimate:Requirement" name="PR12.1 All changes shall be registered and classified in a consistent manner. Classification shall be based on defined criteria and consider different types of changes including emergency changes and major changes." id="a7cbd0cb-81aa-4574-8e2b-8a331e6c8308"/>
    <element xsi:type="archimate:Requirement" name="PR4.4 Availability of services and service components shall be monitored." id="a766fd5c-eead-427c-ac24-12b1258eca26"/>
    <element xsi:type="archimate:Requirement" name="PR13.1 Release and deployment strategies shall be defined together with the service components and CIs to which they are applied. Strategies shall be aligned with the frequency and impact of releases as well as the technology supporting deployment." id="a8db3af2-3523-410a-9f67-a729e523e713"/>
    <element xsi:type="archimate:Requirement" name="PR9.4 Customers and users shall be kept informed of the progress of incidents and service requests as appropriate." id="9bd71b7d-3116-4624-a0f9-696f1dcedc43"/>
    <element xsi:type="archimate:Requirement" name="PR2.1 A service catalogue shall be maintained." id="4cafa0d3-58b2-4a06-b84d-b56cab580121"/>
    <element xsi:type="archimate:Requirement" name="PR12.6 A schedule of changes shall be maintained. It shall contain details of approved changes and intended deployment dates which shall be communicated to interested parties." id="9f1654c7-3354-4629-bc72-6d4966d2c07a"/>
    <element xsi:type="archimate:Requirement" name="PR13.4 Releases shall be built tested and evaluated against acceptance criteria prior to being deployed. The extent of release testing shall be appropriate to the type of release and its potential impact on services." id="abeed46d-aa08-454b-9415-ae2a2c4d4b8e"/>
    <element xsi:type="archimate:Requirement" name="PR10.1 Problems shall be identified and registered in a consistent manner based on analysing patterns and trends in the occurrence of incidents." id="3fea0b5b-4aef-41be-99f4-bdc954c65c86"/>
    <element xsi:type="archimate:Requirement" name="PR4.1 Service availability and continuity requirements shall be identified and reviewed at planned intervals taking into consideration SLAs." id="49f40dbf-5e11-4d62-9c10-16dab1b27b7e"/>
    <element xsi:type="archimate:Requirement" name="PR8.3 Channels used to communicate with each supplier including escalation mechanisms shall be established." id="3d262ee8-7500-401f-bc4b-db1bdc5afb15"/>
    <element xsi:type="archimate:Requirement" name="PR1.3 The evolution of services through their lifecycle shall be managed. This shall include the planning of new services and major alterations to existing services. Plans shall consider timescales responsibilities new or changed technology" id="296d7e54-c307-4982-b6e4-9ca7d2caec65"/>
    <element xsi:type="archimate:Requirement" name="PR7.4 Service reviews with customers shall be conducted at planned intervals." id="33af04b4-2b55-434f-a426-eb328e895cd1"/>
    <element xsi:type="archimate:Requirement" name="PR8.1 Internal and external suppliers shall be identified." id="c87f9ca4-9861-4f3b-85cc-3d1b99013812"/>
    <element xsi:type="archimate:Requirement" name="PR6.5 Access control including provisioning of access rights shall be carried out in a consistent manner." id="40b17378-8a8e-4b35-8a53-69a75f644efc"/>
    <element xsi:type="archimate:Requirement" name="PR11.1 The scope of configuration management shall be defined together with the types of configuration items (CIs) and relationships to be considered." id="655f1b9b-3e2f-428f-b917-9a4cf34bf61d"/>
    <element xsi:type="archimate:Requirement" name="PR7.2 For each customer there shall be a designated contact responsible for managing the relationship with them." id="f3ad608c-fc6e-428f-8c1f-8ff42bbd008d"/>
    <element xsi:type="archimate:Requirement" name="PR13.3 Deployment of releases shall be planned including acceptance criteria as needed." id="2e273bfe-0a1a-4a01-a615-0cfa0bd86f3e"/>
    <element xsi:type="archimate:Requirement" name="PR4.2 Service availability and continuity risks shall be assessed at planned intervals." id="459c3ff8-e6dd-46ee-a626-74bc0dcf3db2"/>
    <element xsi:type="archimate:Requirement" name="PR9.6 Major incidents shall be identified based on defined criteria and handled in a consistent manner." id="baeac11a-e0ca-401a-9295-9e967148f1a7"/>
    <element xsi:type="archimate:Requirement" name="PR12.2 For each type of change steps shall be defined for handling them in a consistent manner." id="4dba121a-f00b-4118-881f-5eb5d1605c97"/>
    <element xsi:type="archimate:Requirement" name="PR12.5 Changes shall be subject to a post implementation review as needed and closed in a consistent manner." id="6a5daf47-904a-434d-8375-a330f32086ac"/>
    <element xsi:type="archimate:Requirement" name="PR14.1 Opportunities for improvement of services and processes shall be identified and registered based on reports as well as results from measurements assessments and audits of the SMS." id="c6db6160-34f7-4ace-b069-36b2829e1cca"/>
    <element xsi:type="archimate:Requirement" name="PR3.3 Reports shall be produced and delivered to their recipients according to specifications." id="d386661e-8baf-42e1-8b47-329b19419ec8"/>
    <element xsi:type="archimate:Requirement" name="PR1.1 A service portfolio shall be maintained. All services shall be specified as part of the service portfolio." id="d6461f56-be9c-46be-bb63-00dbf8be4c45"/>
    <element xsi:type="archimate:Requirement" name="PR1.2 Proposals for new or changed services shall be evaluated based on predicted demand required resources and expected benefits." id="3a26a5fb-7a86-4088-b792-47bb900547e6"/>
  </folder>
